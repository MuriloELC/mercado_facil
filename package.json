{
  "name": "nota-mvp-web-admin",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "web",
    "mobile"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "npm run dev --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace web",
    "dev:mobile": "npm run start --workspace mobile",
    "start:mobile": "npm run start --workspace mobile",
    "typecheck:mobile": "npm run typecheck --workspace mobile",
    "build": "npm run build --workspace backend && npm run build --workspace web",
    "test": "npm run test --workspace backend",
    "db:up": "docker compose up -d db",
    "db:test:up": "docker compose --profile test up -d db-test",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed-defaults --workspace backend",
    "rag:up": "docker compose --profile rag up -d rag",
    "rag:index": "docker compose --profile rag run --rm rag python -m app.index_catalog",
    "check": "npm run build && npm run typecheck:mobile && npm test"
  },
  "overrides": {
    "expo": "54.0.35",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  }
}
