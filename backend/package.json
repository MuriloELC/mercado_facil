{
    "name": "nota-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "prebuild": "npm run clean",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "db:migrate": "ts-node scripts/migrate.ts",
        "db:seed-admin": "ts-node scripts/seed-admin.ts",
        "db:seed-defaults": "ts-node scripts/seed-admin.ts",
        "test": "jest --config ./jest.config.ts",
        "test:watch": "jest --watch --config ./jest.config.ts",
        "test:e2e": "jest --config ./jest.config.ts --runInBand"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.6.1",
        "jpeg-js": "^0.4.4",
        "jsqr": "^1.4.0",
        "multer": "^2.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "playwright": "^1.58.2",
        "pngjs": "^7.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.13.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "8.11.11",
        "@types/pngjs": "^6.0.5",
        "@types/supertest": "^6.0.3",
        "jest": "^30.0.5",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.8.3"
    }
}
