NODE_ENV=production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lista_compras
JWT_SECRET=replace-with-strong-secret
PORT=3001
UPLOAD_DIR=uploads/receipts
LOG_LEVELS=log,error,warn
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=replace-before-deploy
DEFAULT_USER_EMAIL=user@yourdomain.com
DEFAULT_USER_PASSWORD=replace-before-deploy
BCRYPT_ROUNDS=12
LOG_FILE_PATH=logs/backend.log

RAG_API_URL=http://localhost:8001
RAG_TIMEOUT_MS=30000
